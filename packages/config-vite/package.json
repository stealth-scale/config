{
  "name": "@stealthscale/config-vite",
  "version": "0.0.0",
  "description": "Composes a Vite+ config out of layers: presets set, contributions append, removals take back, overrides rewrite.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stealth-scale/config.git",
    "directory": "packages/config-vite"
  },
  "files": [
    "dist",
    "globals.d.ts"
  ],
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    ".": {
      "stealth-source": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./preset/app": {
      "stealth-source": "./src/preset/app.ts",
      "default": "./dist/preset/app.mjs"
    },
    "./preset/base": {
      "stealth-source": "./src/preset/base.ts",
      "default": "./dist/preset/base.mjs"
    },
    "./preset/node": {
      "stealth-source": "./src/preset/node.ts",
      "default": "./dist/preset/node.mjs"
    },
    "./preset/web": {
      "stealth-source": "./src/preset/web.ts",
      "default": "./dist/preset/web.mjs"
    },
    "./preset/workspace": {
      "stealth-source": "./src/preset/workspace.ts",
      "default": "./dist/preset/workspace.mjs"
    },
    "./package.json": "./package.json",
    "./globals": "./globals.d.ts"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./preset/app": "./dist/preset/app.mjs",
      "./preset/base": "./dist/preset/base.mjs",
      "./preset/node": "./dist/preset/node.mjs",
      "./preset/web": "./dist/preset/web.mjs",
      "./preset/workspace": "./dist/preset/workspace.mjs",
      "./package.json": "./package.json",
      "./globals": "./globals.d.ts"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "dev": "vp pack --watch",
    "prepublishOnly": "vp pack",
    "test": "vp test"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "@module-federation/vite": "catalog:",
    "@stealthscale/config-core": "workspace:^",
    "@stealthscale/config-typescript": "workspace:^",
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint-plugin-jsdoc": "catalog:",
    "eslint-plugin-perfectionist": "catalog:",
    "eslint-plugin-tsdoc": "catalog:",
    "playwright": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@module-federation/vite": "catalog:",
    "@stealthscale/config-core": "workspace:^",
    "eslint-plugin-jsdoc": "catalog:",
    "eslint-plugin-perfectionist": "catalog:",
    "eslint-plugin-tsdoc": "catalog:",
    "happy-dom": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependenciesMeta": {
    "happy-dom": {
      "optional": true
    },
    "@module-federation/vite": {
      "optional": true
    }
  }
}
