{
  "name": "@stealthscale/scale",
  "version": "0.0.0",
  "private": true,
  "description": "Builds, checks, tests and releases every stealthscale package.",
  "type": "module",
  "scripts": {
    "bootstrap": "pnpm -r --filter '{packages/*}' run build",
    "prepare": "lefthook install",
    "ready": "pnpm run bootstrap && vp run ci"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@commitlint/cli": "catalog:",
    "@stealthscale/testing-config": "workspace:^",
    "@stealthscale/vite-config": "workspace:^",
    "@stealthscale/vite-config-css": "workspace:^",
    "@stealthscale/vite-config-react": "workspace:^",
    "@stealthscale/vite-config-typescript": "workspace:^",
    "@types/node": "catalog:",
    "@vitest/eslint-plugin": "catalog:",
    "eslint-plugin-jsdoc": "catalog:",
    "eslint-plugin-perfectionist": "catalog:",
    "eslint-plugin-tsdoc": "catalog:",
    "lefthook": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.1",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^26",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm"
}
