# Copy to .env at the repository root to override what a configuration states. Nothing here is
# needed: every value has an answer in the configuration that names it, and this file exists so one
# machine can differ without editing the tree.
#
# A package may keep a .env of its own, which overrides this one for that package alone. Three
# sources, each beating the one before it: this file, then the package's, then the shell.
#
# Read by the configuration in node. None of it reaches a build, so none of it is substituted into
# anything a browser loads.

# The names the dev and preview servers answer to, replacing whatever each application states.
# Comma separated, no scheme and no port.
STEALTH_HOSTS=

# The origins allowed to fetch what those servers serve, replacing whatever is stated. Comma
# separated, each a scheme, a name and a port.
STEALTH_ORIGINS=
